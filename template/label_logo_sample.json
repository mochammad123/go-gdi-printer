{
  "name": "Label Kain dengan Logo (80x30)",
  "width_mm": 80,
  "height_mm": 30,
  "elements": [
    {
      "id": "el_logo",
      "type": "image",
      "x": 3,
      "y": 3,
      "width": 15,
      "height": 10,
      "src": "assets/sample_logo.png"
    },
    {
      "id": "el_title",
      "type": "text",
      "x": 20,
      "y": 3,
      "text": "KNITTO TEXTILE",
      "fontSize": 12,
      "bold": true
    },
    {
      "id": "el_sub",
      "type": "text",
      "x": 20,
      "y": 8,
      "text": "{{nama_kain}} - {{warna_kain}}",
      "fontSize": 9,
      "bold": false
    },
    {
      "id": "el_divider",
      "type": "line",
      "x": 3,
      "y": 14,
      "width": 74,
      "dashed": true
    },
    {
      "id": "el_roll",
      "type": "text",
      "x": 3,
      "y": 16,
      "text": "Roll: {{roll_pecahan}}",
      "fontSize": 9,
      "bold": true
    },
    {
      "id": "el_barcode",
      "type": "barcode",
      "x": 3,
      "y": 20,
      "width": 45,
      "height": 7,
      "text": "{{roll_pecahan}}",
      "dot_width": 2
    }
  ]
}
